# Optional local endpoints. Seed mode does not require either value.
MISSION_CONTROL_COLLECTOR_URL=http://127.0.0.1:4319/hooks
MISSION_CONTROL_PROMETHEUS_URL=http://127.0.0.1:9464/metrics

# Privacy flags must remain off. Agent Mission Control uses aggregate metrics only.
OTEL_LOG_USER_PROMPTS=0
OTEL_LOG_ASSISTANT_RESPONSES=0
OTEL_LOG_TOOL_DETAILS=0
OTEL_LOG_TOOL_CONTENT=0
OTEL_LOG_RAW_API_BODIES=0
