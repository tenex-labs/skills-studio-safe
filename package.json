{
  "name": "agent-mission-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n ui,collector -c green,cyan \"npm:dev:ui\" \"npm:dev:server\"",
    "dev:ui": "vite",
    "dev:server": "tsx watch server/index.ts",
    "doctor": "node scripts/doctor.mjs",
    "workshop": "node scripts/workshop.mjs",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "preflight": "node scripts/preflight.mjs && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "connect:claude": "node scripts/connect-claude.mjs",
    "disconnect:claude": "node scripts/disconnect-claude.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
